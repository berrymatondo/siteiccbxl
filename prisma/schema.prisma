// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Media {
  id        String   @id @default(cuid())
  key       String   @unique // Identifiant unique comme "hero_image_1", "pastor_yvan", etc.
  imageData String   @db.Text // Image en base64
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("media")
}

model VideoEmbed {
  id        String   @id @default(cuid())
  key       String   @unique // "featured_video" ou "hero_video"
  url       String
  title     String?
  duration  String?
  speaker   String?
  thumbnail String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("video_embeds")
}

model ContentCard {
  id        String   @id @default(cuid())
  position  Int      // Position dans la liste (0, 1, 2)
  title     String
  url       String
  imageData String   @db.Text // Image en base64
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([position])
  @@map("content_cards")
}
